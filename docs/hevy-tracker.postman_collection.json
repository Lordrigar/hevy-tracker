{
  "info": {
    "_postman_id": "e3ca4b42-2bce-41d7-a842-cc8b249c10ab",
    "name": "Hevy Tracker — Local API",
    "description": "Import this collection into Postman to exercise the local Hevy Tracker API. Keep it in sync with every public REST endpoint. Secrets are variables only; never commit populated values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string",
      "description": "Local NestJS API base URL. Override for a non-default local port."
    },
    {
      "key": "hevyApiKey",
      "value": "",
      "type": "string",
      "description": "Reserved for manual Hevy API troubleshooting only. The local API reads HEVY_API_KEY from .env; do not send this value to local endpoints or commit a real key."
    },
    {
      "key": "apiToken",
      "value": "",
      "type": "string",
      "description": "Reserved for a future local API authentication scheme. The v1 local API has no user authentication."
    },
    {
      "key": "healthEntryId",
      "value": "",
      "type": "string",
      "description": "Set automatically after the create/upsert request and used by the update and delete requests."
    }
  ],
  "item": [
    {
      "name": "Foundation",
      "item": [
        {
          "name": "API health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/status",
              "host": ["{{baseUrl}}"],
              "path": ["health", "status"]
            },
            "description": "Confirms the local NestJS API is running. This endpoint never triggers a Hevy sync or ChatGPT analysis."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('returns the expected service and database status', function () {",
                  "  pm.expect(pm.response.json()).to.deep.equal({ status: 'ok', service: 'hevy-tracker-api', database: 'connected' });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health entries",
      "description": "Local database CRUD only. These requests never trigger a Hevy sync, weekly report, or ChatGPT analysis.",
      "item": [
        {
          "name": "Create or upsert daily entry",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-07-26\",\n  \"weightKg\": 80.2,\n  \"waistCm\": 82,\n  \"chestCm\": 102,\n  \"bicepCm\": 38,\n  \"steps\": 8000,\n  \"calories\": 2500,\n  \"calorieTarget\": 2600\n}"
            },
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Creates an entry for the specified UTC date or updates the existing entry for that date."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates or updates successfully', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "pm.test('returns the daily entry id', function () { pm.collectionVariables.set('healthEntryId', pm.response.json().id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List daily entries",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update entry by id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-07-26\",\n  \"weightKg\": 79.8,\n  \"steps\": 9000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/health/{{healthEntryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["health", "{{healthEntryId}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('updates successfully', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete entry by id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/{{healthEntryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["health", "{{healthEntryId}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deletes successfully', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns a compact success result', function () { pm.expect(pm.response.json()).to.deep.equal({ success: true }); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid entry",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"invalid\",\n  \"weightKg\": 10,\n  \"steps\": -1\n}"
            },
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns validation error', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Hevy manual import",
      "description": "These requests are the only local API actions that contact Hevy. Run sync only when you intentionally want to download fresh data. The key remains in the local API environment and is never sent by Postman.",
      "item": [
        {
          "name": "Get Hevy sync status",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hevy/status",
              "host": ["{{baseUrl}}"],
              "path": ["hevy", "status"]
            },
            "description": "Reads the local sync state only; it never contacts Hevy."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns local sync status', function () { pm.response.to.have.status(200); });",
                  "pm.test('does not return a secret', function () { pm.expect(JSON.stringify(pm.response.json())).to.not.include('HEVY_API_KEY'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Sync Hevy data (manual trigger)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hevy/sync",
              "host": ["{{baseUrl}}"],
              "path": ["hevy", "sync"]
            },
            "description": "Explicitly downloads paginated workouts, exercise templates, and body measurements from Hevy. This may use your Hevy API quota; run it only when you request fresh data."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns successful import data', function () { pm.response.to.have.status(201); });",
                  "pm.test('returns an import count without secrets', function () { var body = pm.response.json(); pm.expect(body.status).to.eql('succeeded'); pm.expect(body.imported).to.be.a('number'); pm.expect(JSON.stringify(body)).to.not.include('HEVY_API_KEY'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Future endpoints",
      "description": "Add requests here only in the task that introduces their API endpoint. Each request must include a no-secret example body, expected status tests, and manual-trigger behaviour where relevant.",
      "item": []
    }
  ]
}
