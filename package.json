{
  "name": "hevy-tracker",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @hevy/api --filter @hevy/web dev",
    "build": "corepack pnpm -r --if-present run build",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "lint": "corepack pnpm -r --if-present run lint",
    "lint:architecture": "node scripts/lint-architecture.mjs",
    "lint:security": "node scripts/lint-security.mjs",
    "test:unit": "corepack pnpm -r --if-present run test:unit",
    "test:integration": "corepack pnpm -r --if-present run test:integration",
    "test": "corepack pnpm run test:unit && corepack pnpm run test:integration",
    "db:generate": "corepack pnpm --filter @hevy/api prisma:generate",
    "db:migrate": "corepack pnpm --filter @hevy/api prisma:migrate"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
