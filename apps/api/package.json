    "rxjs": "^7.8.2"
  },
  "devDependencies": { "@nestjs/testing": "^11.1.3", "@types/node": "^22.15.0", "tsx": "^4.20.3", "typescript": "^5.8.3", "vitest": "^3.2.4" }
}
