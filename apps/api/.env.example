# Local API and PostgreSQL configuration. Docker Compose loads this file for both services.
POSTGRES_DB=hevy_tracker
POSTGRES_USER=hevy
POSTGRES_PASSWORD=change-me
# Used by host-run Prisma commands. Docker Compose overrides the host with its `postgres` service.
DATABASE_URL=postgresql://hevy:change-me@localhost:5432/hevy_tracker?schema=public
HEVY_API_KEY=
API_PORT=3000
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
