generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthEntry {
  id            String   @id @default(cuid())
  date          DateTime @unique @db.Date
  steps         Int?
  calories      Int?
  calorieTarget Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
}

model Workout {
  id        String     @id
  title     String
  startedAt DateTime
  endedAt   DateTime?
  raw       Json
  exercises Exercise[]
  updatedAt DateTime   @updatedAt

  @@index([startedAt])
}

model HevyExerciseTemplate {
  id                    String   @id
  title                 String
  type                  String?
  primaryMuscleGroup    String?
  secondaryMuscleGroups Json?
  isCustom              Boolean?
  raw                   Json
  updatedAt             DateTime @updatedAt
}

model HevyBodyMeasurement {
  date              DateTime @id @db.Date
  weightKg          Float?
  bodyFatPercentage Float?
  chestCm           Float?
  waistCm           Float?
  hipsCm            Float?
  bicepCm           Float?
  raw               Json
  updatedAt         DateTime @updatedAt
}

model Exercise {
  id          String       @id @default(cuid())
  workoutId   String
  templateId  String?
  name        String
  muscleGroup String?
  workout     Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets        WorkoutSet[]

  @@index([workoutId])
  @@index([templateId])
}

model WorkoutSet {
  id         String   @id @default(cuid())
  exerciseId String
  weightKg   Float?
  reps       Int?
  rpe        Float?
  ordinal    Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, ordinal])
  @@index([exerciseId])
}

model SyncState {
  id           String   @id @default("hevy")
  lastSyncedAt DateTime?
  lastEventAt  DateTime?
  status       String   @default("never")
  message      String?
  updatedAt    DateTime @updatedAt
}

model SyncLog {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String
  mode       String    @default("initial")
  imported   Int       @default(0)
  updated    Int       @default(0)
  deleted    Int       @default(0)
  message    String?

  @@index([startedAt])
}

model WeeklyReport {
  id        String   @id @default(cuid())
  weekStart DateTime @unique @db.Date
  report    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekStart])
}
